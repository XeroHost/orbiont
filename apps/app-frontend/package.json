{
	"name": "@orbiont/app-frontend",
	"private": true,
	"version": "1.0.0-beta.3",
	"type": "module",
	"scripts": {
		"dev": "pnpm -w i18n:coverage && vite",
		"build": "pnpm -w i18n:coverage && pnpm tsc:check && vite build",
		"tsc:check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
		"lint": "eslint . && prettier --check .",
		"fix": "eslint . --fix && prettier --write .",
		"intl:extract": "formatjs extract \"src/**/*.{vue,ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --ignore \"**/*.d.ts\" --ignore node_modules --out-file src/locales/en-US/index.json --format crowdin --preserve-whitespace",
		"intl:prune-local": "pnpm -w scripts i18n-icu-contract prune-local --scope apps/app-frontend",
		"test": "pnpm tsc:check && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 tests/*.test.mjs"
	},
	"dependencies": {
		"@dnd-kit/vue": "^0.5.0",
		"@fontsource/inter": "^5.3.0",
		"@orbiont/api-client": "workspace:^",
		"@orbiont/assets": "workspace:*",
		"@orbiont/branding": "workspace:*",
		"@orbiont/ui": "workspace:*",
		"@orbiont/utils": "workspace:*",
		"@sfirew/minecraft-motd-parser": "^1.1.6",
		"@tanstack/vue-query": "5.101.4",
		"@tauri-apps/api": "^2.12.0",
		"@tauri-apps/plugin-dialog": "^2.8.0",
		"@tauri-apps/plugin-fs": "^2.6.0",
		"@tauri-apps/plugin-http": "~2.5.9",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-os": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.13.1",
		"@tauri-apps/plugin-window-state": "^2.5.0",
		"@vueuse/core": "^11.3.0",
		"dayjs": "^1.11.23",
		"fuse.js": "^6.6.2",
		"motion-v": "^2.5.1",
		"ofetch": "^1.5.1",
		"overlayscrollbars": "^2.16.0",
		"three": "^0.172.0",
		"vue": "^3.5.43",
		"vue-i18n": "^10.0.8",
		"vue-router": "^4.6.4",
		"vue3-ace-editor": "^2.2.4",
		"vuedraggable": "^4.1.0"
	},
	"devDependencies": {
		"@types/three": "^0.172.0",
		"@eslint/compat": "^1.4.1",
		"@formatjs/cli": "^6.16.32",
		"@nuxt/eslint-config": "^0.5.7",
		"@orbiont/tooling-config": "workspace:*",
		"@taijased/vue-render-tracker": "^1.0.7",
		"@vitejs/plugin-vue": "^6.0.9",
		"autoprefixer": "^10.6.1",
		"eslint": "^9.39.5",
		"eslint-plugin-turbo": "^2.11.5",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"sass": "^1.105.1",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^8.3.1",
		"vite-svg-loader": "^5.1.3",
		"vue-component-type-helpers": "^3.3.11",
		"vue-tsc": "^3.3.0"
	},
	"packageManager": "pnpm@10.33.2",
	"web-types": "../../web-types.json"
}
