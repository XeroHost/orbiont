{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,

		"moduleResolution": "bundler",
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "preserve",

		"strict": true,

		"types": ["vite/client", "vite-svg-loader", "node"],

		"paths": {
			"@orbiont/api-client": ["../../packages/api-client/src/index.ts"],
			"@orbiont/ui/src/*": ["../../packages/ui/src/*"],
			"#ui/*": ["../../packages/ui/src/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
