{
	"name": "@orbiont/api-client",
	"version": "0.0.0",
	"private": true,
	"description": "API client for the launcher: Modrinth content API, mclo.gs and loader manifests, over Tauri HTTP.",
	"license": "LGPL-3.0-only",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "pnpm run clean && node esbuild.config.mjs",
		"prepare": "pnpm run build",
		"lint": "eslint . && prettier --check .",
		"fix": "eslint . --fix && prettier --write ."
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.59.3",
		"@orbiont/tooling-config": "workspace:*",
		"@tauri-apps/plugin-http": "^2.8.0",
		"esbuild": "0.28.1",
		"typescript": "^5.9.3",
		"unplugin-dts": "^1.1.1"
	},
	"peerDependencies": {
		"@tauri-apps/plugin-http": "^2.0.0"
	},
	"peerDependenciesMeta": {
		"@tauri-apps/plugin-http": {
			"optional": true
		}
	}
}
