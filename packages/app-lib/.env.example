# Copy this file to .env before building or running Orbiont.
# Values are embedded in the application at build time: never put secrets here.

# Public Modrinth content API and launcher metadata.
MODRINTH_URL=https://modrinth.com/
MODRINTH_API_BASE_URL=https://api.modrinth.com/
MODRINTH_API_URL=https://api.modrinth.com/v2/
MODRINTH_API_URL_V3=https://api.modrinth.com/v3/
MODRINTH_LAUNCHER_META_URL=https://launcher-meta.modrinth.com/

# Your Microsoft application's public client ID. Required for sign-in.
# This is a public identifier, not a client secret.
MICROSOFT_CLIENT_ID=

# Optional Discord application ID for Rich Presence. Empty disables it.
DISCORD_CLIENT_ID=

# Application identity. Keep these values consistent with packages/branding.
ORBIONT_PRODUCT_NAME=Orbiont
ORBIONT_SITE_URL=https://xerohost.net/orbiont
ORBIONT_SUPPORT_EMAIL=support@xerohost.net
ORBIONT_DEEP_LINK_SCHEME=orbiont

# Public API facade. CurseForge and MCStat API keys belong on the server only.
ORBIONT_CURSEFORGE_API_URL=https://api-orbiont.xerosrv.com/v1
ORBIONT_SKIN_API_URL=https://api-orbiont.xerosrv.com/v1/skins
ORBIONT_MINECRAFT_TEXTURE_URL=https://textures.minecraft.net/texture/
ORBIONT_MCSTAT_TEXTURE_URL=https://mcstat.org/media/skins/

# Public update manifest. The updater signing key must stay outside this file.
ORBIONT_UPDATES_URL=https://github.com/XeroHost/orbiont/releases/latest/download/updates.json

# Official Microsoft Store page for installing/updating Minecraft for Windows.
ORBIONT_BEDROCK_STORE_URL=https://apps.microsoft.com/detail/9nblggh2jhxj
ORBIONT_BEDROCK_STORE_URI=ms-windows-store://pdp/?ProductId=9nblggh2jhxj
ORBIONT_BEDROCK_UPDATES_URI=ms-windows-store://downloadsandupdates

# Official OptiFine download page and legacy launcher dependency.
ORBIONT_OPTIFINE_DOWNLOADS_URL=https://optifine.net/downloads
ORBIONT_OPTIFINE_LEGACY_WRAPPER_URL=https://libraries.minecraft.net/net/minecraft/launchwrapper/1.12/launchwrapper-1.12.jar
