# Modrinth as a content source (public API, website links, loader manifest).
MODRINTH_URL=https://modrinth.com/
MODRINTH_API_BASE_URL=https://api.modrinth.com/
MODRINTH_API_URL=https://api.modrinth.com/v2/
MODRINTH_API_URL_V3=https://api.modrinth.com/v3/
MODRINTH_LAUNCHER_META_URL=https://launcher-meta.modrinth.com/

# Orbiont's Microsoft (Azure) app registration, approved by Mojang for the
# Minecraft services API. Public client, personal accounts only.
MICROSOFT_CLIENT_ID=1596fe11-fe4c-4f81-b517-d15200a5d955

# Orbiont's Discord application (Rich Presence). Discord shows its name and
# icon; the icon is the art asset named "orbiont-icon-cyan-512x". Empty = Rich Presence off.
DISCORD_CLIENT_ID=1552901927375732847

# Orbiont services. There is no Orbiont datacenter: everything lives under
# xerohost.net. Keep the brand values in sync with packages/branding.
ORBIONT_PRODUCT_NAME=Orbiont
ORBIONT_SITE_URL=https://xerohost.net/orbiont
ORBIONT_SUPPORT_EMAIL=support@xerohost.net
# Deep-link scheme (orbiont://...). Same as deepLinkScheme in packages/branding.
ORBIONT_DEEP_LINK_SCHEME=orbiont
# Catalog: XeroHost modpacks and servers (orbiont-catalog, src/index.js).
ORBIONT_CATALOG_BASE_URL=https://xerohost.net/orbiont/api
# CurseForge facade (orbiont-catalog, src/facade/index.js). The CurseForge
# API key lives only there, never in the launcher.
ORBIONT_CURSEFORGE_API_URL=https://api-curseforge.xerohost.net/v1
# Update manifest, signed with Orbiont's own updater key.
ORBIONT_UPDATES_URL=https://xerohost.net/orbiont/updates.json
