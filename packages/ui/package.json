{
	"name": "@orbiont/ui",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"main": "./index.ts",
	"types": "./index.ts",
	"sideEffects": [
		"**/*.css",
		"**/*.scss",
		"./src/utils/ace-theme.ts",
		"./src/utils/ace-mode-mcfunction.ts"
	],
	"imports": {
		"#ui/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		},
		"./pages": {
			"types": "./src/pages/index.ts",
			"default": "./src/pages/index.ts"
		},
		"./src/*": "./src/*"
	},
	"scripts": {
		"lint": "eslint . && prettier --check .",
		"fix": "eslint . --fix && prettier --write .",
		"intl:extract": "formatjs extract \"src/**/*.{vue,ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --ignore \"src/**/*.d.ts\" --out-file src/locales/en-US/index.json --preserve-whitespace",
		"intl:prune-local": "pnpm -w scripts i18n-icu-contract prune-local --scope packages/ui"
	},
	"devDependencies": {
		"@formatjs/cli": "^6.16.32",
		"@orbiont/tooling-config": "workspace:*",
		"@vitejs/plugin-vue": "^6.0.9",
		"eslint": "^9.39.5",
		"prettier": "^3.9.9",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.9.3",
		"vite": "^8.3.1",
		"vite-svg-loader": "^5.1.3",
		"vue": "^3.5.43",
		"vue-component-type-helpers": "^3.3.11",
		"vue-router": "^4.6.4"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@floating-ui/vue": "^2.0.1",
		"@hugeicons/core-free-icons": "4.3.5",
		"@orbiont/api-client": "workspace:*",
		"@orbiont/assets": "workspace:*",
		"@orbiont/branding": "workspace:*",
		"@orbiont/utils": "workspace:*",
		"@tanstack/vue-query": "5.101.4",
		"@tresjs/cientos": "^4.3.1",
		"@tresjs/core": "^4.3.6",
		"@types/markdown-it": "^14.2.0",
		"@types/three": "^0.172.0",
		"@vueuse/core": "^11.3.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-search": "^0.16.0",
		"@xterm/xterm": "^6.0.0",
		"ace-builds": "^1.44.0",
		"colord": "^2.10.0",
		"dayjs": "^1.11.23",
		"es-toolkit": "^1.52.0",
		"fabric": "^7.4.0",
		"fuse.js": "^6.6.2",
		"intl-messageformat": "^10.7.18",
		"lru-cache": "^11.5.3",
		"motion-v": "^2.5.1",
		"overlayscrollbars": "^2.16.0",
		"qrcode.vue": "^3.11.0",
		"three": "^0.172.0",
		"vue-i18n": "^10.0.8",
		"vue3-ace-editor": "^2.2.4"
	},
	"web-types": "../../web-types.json"
}
